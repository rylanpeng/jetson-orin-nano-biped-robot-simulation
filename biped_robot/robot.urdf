<?xml version="1.0"?>
<robot name="biped_robot">

  <!-- ================= MATERIALS ================= -->
  <material name="gray"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1.0"/></material>
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.35 0.2 0.12"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.35 0.2 0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <!-- ================= LEFT LEG LINKS ================= -->
  <link name="left_hip_yaw_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <origin xyz="0 0 -0.025"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.025"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <link name="left_thigh">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <origin xyz="0 0 -0.15"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <origin xyz="0 0 -0.15"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="left_calf">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.28"/>
      </geometry>
      <origin xyz="0 0 -0.14"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.28"/>
      </geometry>
      <origin xyz="0 0 -0.14"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 -0.14"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <link name="left_foot">
    <visual>
      <geometry>
        <box size="0.2 0.08 0.03"/>
      </geometry>
      <origin xyz="0 0 -0.015"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.08 0.03"/>
      </geometry>
      <origin xyz="0 0 -0.015"/>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 -0.015"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <!-- ================= RIGHT LEG LINKS ================= -->
  <link name="right_hip_yaw_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <origin xyz="0 0 -0.025"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <origin xyz="0 0 -0.025"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 -0.025"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <link name="right_thigh">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <origin xyz="0 0 -0.15"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.3"/>
      </geometry>
      <origin xyz="0 0 -0.15"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 -0.15"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="right_calf">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.28"/>
      </geometry>
      <origin xyz="0 0 -0.14"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.28"/>
      </geometry>
      <origin xyz="0 0 -0.14"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 -0.14"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <link name="right_foot">
    <visual>
      <geometry>
        <box size="0.2 0.08 0.03"/>
      </geometry>
      <origin xyz="0 0 -0.015"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.08 0.03"/>
      </geometry>
      <origin xyz="0 0 -0.015"/>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 -0.015"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>

  <!-- ================= LEFT LEG JOINTS ================= -->
  <joint name="left_hip_yaw_joint" type="revolute">
    <origin xyz="0 0.12 -0.04" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_hip_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="40" velocity="4.0"/>
  </joint>

  <joint name="left_hip_pitch_joint" type="revolute">
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <parent link="left_hip_yaw_link"/>
    <child link="left_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.2" effort="50" velocity="4.0"/>
  </joint>

  <joint name="left_knee_joint" type="revolute">
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <parent link="left_thigh"/>
    <child link="left_calf"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="0.5" effort="50" velocity="4.0"/>
  </joint>

  <joint name="left_ankle_joint" type="revolute">
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <parent link="left_calf"/>
    <child link="left_foot"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="40" velocity="4.0"/>
  </joint>

  <!-- ================= RIGHT LEG JOINTS ================= -->
  <joint name="right_hip_yaw_joint" type="revolute">
    <origin xyz="0 -0.12 -0.04" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_hip_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="40" velocity="4.0"/>
  </joint>

  <joint name="right_hip_pitch_joint" type="revolute">
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    <parent link="right_hip_yaw_link"/>
    <child link="right_thigh"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.2" effort="50" velocity="4.0"/>
  </joint>

  <joint name="right_knee_joint" type="revolute">
    <origin xyz="0 0 -0.3" rpy="0 0 0"/>
    <parent link="right_thigh"/>
    <child link="right_calf"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="0.5" effort="50" velocity="4.0"/>
  </joint>

  <joint name="right_ankle_joint" type="revolute">
    <origin xyz="0 0 -0.28" rpy="0 0 0"/>
    <parent link="right_calf"/>
    <child link="right_foot"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7" upper="0.7" effort="40" velocity="4.0"/>
  </joint>

</robot>
